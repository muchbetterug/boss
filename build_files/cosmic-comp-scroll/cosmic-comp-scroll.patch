+    /// Verschiebt alle Knoten eines Baums waagerecht. Mit `apply` bekommen die Fenster
+    /// ihre neue Lage auch mitgeteilt (nur Lage, die Größe bleibt).
+    fn shift_tree(tree: &mut Tree<Data>, output: &Output, dx: i32, apply: bool) {
+        let Some(root_id) = tree.root_node_id().cloned() else {
+            return;
+        };
+        let ids = tree
+            .traverse_pre_order_ids(&root_id)
+            .unwrap()
+            .collect::<Vec<_>>();
+        for id in ids {
+            match tree.get_mut(&id).unwrap().data_mut() {
+                Data::Group { last_geometry, .. } | Data::Placeholder { last_geometry, .. } => {
+                    last_geometry.loc.x += dx;
+                }
+                Data::Mapped {
+                    mapped,
+                    last_geometry,
+                    ..
+                } => {
+                    last_geometry.loc.x += dx;
+                    if apply && !(mapped.is_fullscreen(true) || mapped.is_maximized(true)) {
+                        mapped.set_geometry(last_geometry.to_global(output));
+                        let _ = mapped.configure();
+                    }
+                }
+            }
+        }
+    }
+
+    /// Verschiebt den Ausschnitt um `dx` Pixel (positiv = nach rechts). Wirkt sofort auf alle
+    /// Bäume der Warteschlange, damit laufende Animationen das Scrollen nicht aufhalten.
+    fn shift_strip(&mut self, dx: i32) -> bool {
+        let Some((current, min, max)) = self.strip_scroll_state() else {
+            return false;
+        };
+        let target = (current + dx).clamp(min, max);
+        let shift = current - target;
+        if shift == 0 {
+            return false;
+        }
+        let output = self.output.clone();
+        let last = self.queue.trees.len() - 1;
+        for (i, (tree, _, _)) in self.queue.trees.iter_mut().enumerate() {
+            TilingLayout::shift_tree(tree, &output, shift, i == last);
+        }
+        true
+    }
+
+    /// Folgt direkt den Fingern (Touchpad, Wischgeste) und merkt sich die Geschwindigkeit
+    /// für das Ausgleiten nach dem Loslassen.
+    pub fn scroll_strip(&mut self, dx: i32) -> bool {
+        self.strip_animation = None;
+        let now = Instant::now();
+        let velocity = match self.strip_velocity {
+            Some((last, v)) => {
+                let dt = now.duration_since(last).as_secs_f64();
+                if dt > 0.1 {
+                    0.0
+                } else {
+                    let measured = (dx as f64 / dt.max(0.004)).clamp(-30000.0, 30000.0);
+                    0.5 * measured + 0.5 * v
+                }
+            }
+            None => 0.0,
+        };
+        self.strip_velocity = Some((now, velocity));
+        self.shift_strip(dx)
+    }
+
+    /// Weicher Scrollschritt (Mausrad). Mehrere Schritte hintereinander addieren sich
+    /// zum Ziel der laufenden Bewegung.
+    pub fn scroll_strip_smooth(&mut self, dx: i32) -> bool {
+        self.strip_velocity = None;
+        let base = self.strip_animation.as_ref().map(|a| a.to);
+        self.animate_strip(base, dx as f64, STRIP_SCROLL_DURATION, StripEasing::Gentle)
+    }
+
+    /// Nach dem Loslassen mit der zuletzt gemessenen Geschwindigkeit ausgleiten.
+    pub fn fling_strip(&mut self) -> bool {
+        let Some((last, velocity)) = self.strip_velocity.take() else {
+            return false;
+        };
+        if last.elapsed() > Duration::from_millis(80) || velocity.abs() < 200.0 {
+            return false;
+        }
+        self.animate_strip(
+            None,
+            velocity * STRIP_FLING_TAU,
+            Duration::from_secs_f64(STRIP_FLING_TAU * 3.0),
+            StripEasing::Fling,
+        )
+    }
+
+    fn animate_strip(
+        &mut self,
+        base: Option<f64>,
+        dx: f64,
+        duration: Duration,
+        easing: StripEasing,
+    ) -> bool {
+        let Some((current, min, max)) = self.strip_scroll_state() else {
+            self.strip_animation = None;
+            return false;
+        };
+        let to = (base.unwrap_or(current as f64) + dx).clamp(min as f64, max as f64);
+        if (to - current as f64).abs() < 1.0 {
+            self.strip_animation = None;
+            return false;
+        }
+        self.strip_animation = Some(StripAnimation {
+            from: current as f64,
+            to,
+            start: Instant::now(),
+            duration,
+            easing,
+        });
+        true
+    }
+
+    /// Ein Schritt der weichen Bewegung, einmal je Bild.
+    fn step_strip_animation(&mut self) {
+        let Some(animation) = self.strip_animation.clone() else {
+            return;
+        };
+        let t = (animation.start.elapsed().as_secs_f64() / animation.duration.as_secs_f64())
+            .min(1.0);
+        let eased = animation.easing.apply(t);
+        let target = animation.from + (animation.to - animation.from) * eased;
+        match self.strip_scroll_state() {
+            Some((current, _, _)) => {
+                let dx = target.round() as i32 - current;
+                if dx != 0 {
+                    self.shift_strip(dx);
+                }
+                if t >= 1.0 {
+                    self.strip_animation = None;
+                }
+            }
+            None => self.strip_animation = None,
+        }
+    }
+
+    /// Scrollt so wenig wie möglich, damit `rect` ganz sichtbar ist (weich). Ist `rect` breiter
+    /// als der Bildschirm, wird es links bündig gezeigt.
+    pub fn scroll_strip_to_show(&mut self, rect: Rectangle<i32, Local>) -> bool {
+        let dx = self.strip_dx_to_show(rect);
+        dx != 0 && self.animate_strip(None, dx as f64, STRIP_SCROLL_DURATION, StripEasing::Gentle)
+    }
+
+    fn strip_dx_to_show(&self, rect: Rectangle<i32, Local>) -> i32 {
+        let viewport = self.strip_viewport();
+        if rect.loc.x < viewport.loc.x || rect.size.w >= viewport.size.w {
+            rect.loc.x - viewport.loc.x
+        } else if rect.loc.x + rect.size.w > viewport.loc.x + viewport.size.w {
+            rect.loc.x + rect.size.w - (viewport.loc.x + viewport.size.w)
+        } else {
+            0
+        }
+    }
+
+    pub fn scroll_strip_to_window(&mut self, mapped: &CosmicMapped) -> bool {
+        let Some(mut geo) = self.element_geometry(mapped) else {
+            return false;
+        };
+        let (_, inner) = self.gaps();
+        geo.loc.x -= inner;
+        geo.size.w += inner * 2;
+        self.scroll_strip_to_show(geo)
+    }
+
+    /// Hält den rechten Rand des Streifens sichtbar (beim Verbreitern am Außenrand). Sofort,
+    /// nicht weich: das Ziehen setzt bei jeder Bewegung neu auf den Baum vom Griffbeginn auf.
+    pub fn scroll_strip_to_end(&mut self) -> bool {
+        let tree = &self.queue.trees.back().unwrap().0;
+        let Some(geo) = tree
+            .root_node_id()
+            .and_then(|id| tree.get(id).ok())
+            .map(|node| *node.data().geometry())
+        else {
+            return false;
+        };
+        self.strip_animation = None;
+        let dx = self.strip_dx_to_show(Rectangle::new(
+            (geo.loc.x + geo.size.w - 1, geo.loc.y).into(),
+            (1, geo.size.h).into(),
+        ));
+        dx != 0 && self.shift_strip(dx)
+    }
+
+    /// Breite der sichtbaren Fläche, für die Schrittweite beim Scrollen.
+    pub fn strip_viewport_width(&self) -> i32 {
+        self.strip_viewport().size.w
+    }
+
+    /// Fläche für die Darstellung: wie `zone`, aber so breit und so verschoben wie der Streifen.
+    fn strip_zone(&self, zone: Rectangle<i32, Local>) -> Rectangle<i32, Local> {
+        let tree = &self.queue.trees.back().unwrap().0;
+        TilingLayout::strip_zone_for(tree, self.gaps().0, zone)
+    }
+
+    fn strip_zone_for(
+        tree: &Tree<Data>,
+        outer: i32,
+        zone: Rectangle<i32, Local>,
+    ) -> Rectangle<i32, Local> {
+        match tree.root_node_id().and_then(|id| tree.get(id).ok()) {
+            Some(root) if root.data().is_strip() => {
+                let geo = root.data().geometry();
+                Rectangle::new(
+                    (geo.loc.x - outer, zone.loc.y).into(),
+                    (geo.size.w + outer * 2, zone.size.h).into(),
+                )
+            }
+            _ => zone,
+        }
+    }
