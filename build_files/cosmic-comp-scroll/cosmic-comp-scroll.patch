+    /// Hängt ein neues Fenster als Spalte rechts neben die Spalte von `focused` an.
+    /// Solange der Streifen nicht breiter als der Bildschirm ist und höchstens
+    /// `STRIP_COLUMNS_PER_SCREEN` Spalten entstehen, teilen sie sich den Bildschirm gleichmäßig;
+    /// danach bekommt die neue Spalte ein Drittel der Bildschirmbreite und der Streifen wächst.
+    fn append_to_strip(
+        tree: &mut Tree<Data>,
+        new_window: Node<Data>,
+        focused: Option<&NodeId>,
+        zone_w: i32,
+    ) -> NodeId {
+        let root_id = tree.root_node_id().cloned().unwrap();
+
+        if !tree.get(&root_id).unwrap().data().is_strip() {
+            // noch kein Streifen: alte Wurzel und neues Fenster nebeneinander
+            let new_id = tree.insert(new_window, InsertBehavior::AsRoot).unwrap();
+            TilingLayout::new_group(tree, &root_id, &new_id, Orientation::Vertical).unwrap();
+            return new_id;
+        }
+
+        // die Spalte (direktes Kind der Wurzel), in der das aktive Fenster steckt
+        let count = tree.children_ids(&root_id).unwrap().count();
+        let idx = focused
+            .filter(|id| tree.get(id).is_ok())
+            .and_then(|id| {
+                let mut column = id.clone();
+                while let Some(parent) = tree.get(&column).unwrap().parent().cloned() {
+                    if parent == root_id {
+                        break;
+                    }
+                    column = parent;
+                }
+                tree.children_ids(&root_id)
+                    .unwrap()
+                    .position(|child| child == &column)
+            })
+            .map(|pos| pos + 1)
+            .unwrap_or(count);
+
+        let column_w = (zone_w / STRIP_COLUMNS_PER_SCREEN).max(360);
+        let data = tree.get_mut(&root_id).unwrap().data_mut();
+        let fits = match data {
+            Data::Group { sizes, .. } => {
+                sizes.iter().sum::<i32>() <= zone_w
+                    && (count as i32) < STRIP_COLUMNS_PER_SCREEN
+            }
+            _ => false,
+        };
+        if fits {
+            data.add_window(idx);
+        } else if let Data::Group { sizes, .. } = data {
+            sizes.insert(idx, column_w);
+        }
+
+        let new_id = tree
+            .insert(new_window, InsertBehavior::UnderNode(&root_id))
+            .unwrap();
+        tree.make_nth_sibling(&new_id, idx).unwrap();
+        new_id
+    }
