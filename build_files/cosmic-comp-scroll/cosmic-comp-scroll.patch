+        {
+            Some((_id, FocusedNodeData::Window(mapped))) => tree
+                .traverse_pre_order_ids(&root_id)
+                .unwrap()
+                .find(|id| tree.get(id).unwrap().data().is_mapped(Some(&mapped))),
+            Some((id, FocusedNodeData::Group(_, _))) => Some(id),
