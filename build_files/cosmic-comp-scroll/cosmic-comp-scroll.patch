+    /// Sichtbare Fläche für Fenster: nicht-exklusive Zone abzüglich äußerer Abstände.
+    fn strip_viewport(&self) -> Rectangle<i32, Local> {
+        let (outer, _) = self.gaps();
+        let mut geo = layer_map_for_output(&self.output)
+            .non_exclusive_zone()
+            .as_local();
+        geo.loc.x += outer;
+        geo.loc.y += outer;
+        geo.size.w -= outer * 2;
+        geo.size.h -= outer * 2;
+        geo
+    }
+
+    /// Fläche, auf der der Baum angeordnet wird: so breit wie die Spalten zusammen,
+    /// mindestens `viewport`, und um den aktuellen Versatz nach links geschoben.
+    /// Der Versatz wird aus der bisherigen Lage der Wurzel gelesen.
+    fn strip_area(
+        tree: &mut Tree<Data>,
+        root_id: &NodeId,
+        viewport: Rectangle<i32, Local>,
+    ) -> Rectangle<i32, Local> {
+        let data = tree.get_mut(root_id).unwrap().data_mut();
+        let Data::Group {
+            orientation: Orientation::Vertical,
+            sizes,
+            last_geometry,
+            ..
+        } = data
+        else {
+            return viewport;
+        };
+
+        let content_w: i32 = sizes.iter().sum();
+        let previous_x = last_geometry.loc.x;
+        // `update_geometry` skaliert von der alten Länge auf die neue: die alte Länge
+        // muss darum die tatsächliche Summe sein, damit nur bei Bedarf aufgefüllt wird.
+        last_geometry.size.w = content_w;
+
+        let width = content_w.max(viewport.size.w);
+        // so breit, wie die Spalten nach dem Auffüllen sein werden
+        let scale = |w: i32| (w as i64 * width as i64 / content_w.max(1) as i64) as i32;
+        let (min, max) = TilingLayout::strip_bounds(
+            scale(sizes.first().copied().unwrap_or(0)),
+            scale(sizes.last().copied().unwrap_or(0)),
+            width,
+            viewport.size.w,
+        );
+        let scroll = (viewport.loc.x - previous_x).clamp(min, max);
+        Rectangle::new(
+            (viewport.loc.x - scroll, viewport.loc.y).into(),
+            (width, viewport.size.h).into(),
+        )
+    }
+
+    /// Grenzen des Versatzes: Der Streifen lässt sich immer verschieben, auch wenn die
+    /// Spalten den Bildschirm nicht füllen - nach rechts, bis die erste Spalte am rechten
+    /// Rand steht, nach links, bis die letzte Spalte am linken Rand steht.
+    fn strip_bounds(first_w: i32, last_w: i32, width: i32, viewport_w: i32) -> (i32, i32) {
+        let min = (first_w.min(viewport_w) - viewport_w).min(0);
+        let max = (width - last_w.min(viewport_w)).max(0);
+        (min, max)
+    }
