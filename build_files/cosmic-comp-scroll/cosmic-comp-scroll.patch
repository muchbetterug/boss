+    /// Hängt ein neues Fenster als Spalte an den Streifen, an der Stelle `placement`.
+    /// Auf einem externen Bildschirm (`external`) bekommt sie immer ein Drittel der Breite.
+    /// Sonst gilt: Solange der Streifen nicht breiter als der Bildschirm ist und höchstens
+    /// `STRIP_COLUMNS_PER_SCREEN` Spalten entstehen, teilen sie sich den Bildschirm gleichmäßig;
+    /// eine Lücke füllt die neue Spalte; danach bekommt sie ein Drittel und der Streifen wächst.
+    fn append_to_strip(
+        tree: &mut Tree<Data>,
+        new_window: Node<Data>,
+        focused: Option<&NodeId>,
+        placement: StripPlacement,
+        external: bool,
+        viewport_w: i32,
+        column_w: i32,
+    ) -> NodeId {
+        let root_id = tree.root_node_id().cloned().unwrap();
+
+        if !tree.get(&root_id).unwrap().data().is_strip() {
+            // noch kein Streifen: alte Wurzel und neues Fenster nebeneinander
+            let new_id = tree.insert(new_window, InsertBehavior::AsRoot).unwrap();
+            TilingLayout::new_group(tree, &root_id, &new_id, Orientation::Vertical).unwrap();
+            let first = match placement {
+                StripPlacement::Start => true,
+                StripPlacement::Ranked(rank) => column_app_id(tree, &root_id).is_some_and(|id| {
+                    external_app_rank(&id).is_some_and(|other| other > rank) || id == "kitty"
+                }),
+                _ => false,
+            };
+            if first {
+                tree.make_nth_sibling(&new_id, 0).unwrap();
+            }
+            return new_id;
+        }
+
+        // die Spalte (direktes Kind der Wurzel), in der das aktive Fenster steckt
+        let count = tree.children_ids(&root_id).unwrap().count();
+        let idx = match placement {
+            StripPlacement::Start => Some(0),
+            StripPlacement::End => Some(count),
+            StripPlacement::AfterFocused => None,
+            StripPlacement::Ranked(rank) => Some(
+                tree.children_ids(&root_id)
+                    .unwrap()
+                    .position(|column| {
+                        column_app_id(tree, column).is_some_and(|id| {
+                            external_app_rank(&id).is_some_and(|other| other > rank)
+                                || id == "kitty"
+                        })
+                    })
+                    .unwrap_or(count),
+            ),
