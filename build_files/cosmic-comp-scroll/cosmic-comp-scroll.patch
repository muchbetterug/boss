+                    if parent == root_id {
+                        break;
+                    }
+                    column = parent;
+                }
+                tree.children_ids(&root_id)
+                    .unwrap()
+                    .position(|child| child == &column)
+            })
+            .map(|pos| pos + 1))
+            .unwrap_or(count);
+
+        let data = tree.get_mut(&root_id).unwrap().data_mut();
+        if let Data::Group { sizes, .. } = data {
+            let used: i32 = sizes.iter().sum();
+            let free = viewport_w - used;
+            if external {
+                sizes.insert(idx, column_w);
+            } else if free <= 0 && (count as i32) < STRIP_COLUMNS_PER_SCREEN {
+                // Streifen füllt genau den Bildschirm: gleichmäßig neu aufteilen
