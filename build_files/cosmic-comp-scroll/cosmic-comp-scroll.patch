+// Scroll-Streifen: Ist die Wurzel des Baums eine Spaltengruppe (Orientation::Vertical),
+// darf sie breiter oder schmaler sein als der Bildschirm. Ihre Breite ist genau die Summe
+// der Spaltenbreiten; schließt ein Fenster, behalten die übrigen ihre Breite. Die Gruppe
+// bleibt auch mit nur einer Spalte bestehen. Der Versatz des Ausschnitts steckt in der
+// x-Position der Wurzel und braucht darum keinen eigenen Zustand.
+/// So viele Spalten teilen sich den Bildschirm, bevor neue Fenster angehängt werden.
+pub const STRIP_COLUMNS_PER_SCREEN: i32 = 3;
+/// Dauer eines weichen Scrollschritts (Mausrad, Mitscrollen zum Fenster).
+const STRIP_SCROLL_DURATION: Duration = Duration::from_millis(260);
+/// Dauer der Fahrt zur Mitte (Klick aufs Panel-Symbol); der Weg ist oft länger.
+const STRIP_CENTER_DURATION: Duration = Duration::from_millis(420);
+/// Ausgleiten nach dem Loslassen des Touchpads: Weg = Geschwindigkeit × diese Zeit (s).
+const STRIP_FLING_TAU: f64 = 0.3;
+
+/// Wo eine neue Spalte in den Streifen kommt.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum StripPlacement {
+    /// rechts neben die Spalte des aktiven Fensters
+    AfterFocused,
+    /// ganz links
+    Start,
+    /// ganz rechts
+    End,
+    /// feste Reihenfolge der Standard-Apps: vor die erste Spalte mit höherem Rang
+    /// (oder vor kitty), sonst ganz rechts
+    Ranked(u8),
+}
+
+/// Apps, die bei mehreren Bildschirmen immer auf dem eingebauten erscheinen, und ihr Platz
+/// im Streifen: Todoist ganz links, kitty ganz rechts.
+pub fn builtin_app_placement(app_id: &str) -> Option<StripPlacement> {
+    let app_id = app_id.to_lowercase();
+    if app_id.contains("todoist") {
+        Some(StripPlacement::Start)
+    } else if app_id == "kitty" {
+        Some(StripPlacement::End)
+    } else {
+        None
+    }
+}
+
+/// Apps, die bei mehreren Bildschirmen immer auf dem externen erscheinen, mit ihrem Rang in
+/// der festen Reihenfolge von links nach rechts: Claude, Brave, Zed, Thunderbird.
+pub fn external_app_rank(app_id: &str) -> Option<u8> {
+    let app_id = app_id.to_lowercase();
+    if app_id.contains("anthropic") || app_id.starts_with("claude") {
+        Some(0)
+    } else if app_id.contains("brave") {
+        Some(1)
+    } else if app_id.starts_with("dev.zed.") || app_id == "zed" {
+        Some(2)
+    } else if app_id.contains("thunderbird") {
+        Some(3)
+    } else {
+        None
+    }
+}
+
+/// App-ID des ersten Fensters in einer Spalte.
+fn column_app_id(tree: &Tree<Data>, column: &NodeId) -> Option<String> {
+    tree.traverse_pre_order(column).ok()?.find_map(|node| match node.data() {
+        Data::Mapped { mapped, .. } => Some(mapped.active_window().app_id()),
+        _ => None,
+    })
+}
+
+/// Laufende weiche Bewegung des Ausschnitts, Versatz in Pixeln.
+#[derive(Debug, Clone)]
+struct StripAnimation {
+    from: f64,
+    to: f64,
+    start: Instant,
+    duration: Duration,
+    easing: StripEasing,
+}
+
+#[derive(Debug, Clone, Copy)]
+enum StripEasing {
+    /// sanft anlaufend und auslaufend (Sinus): Mausrad, Mitscrollen
+    Gentle,
+    /// kubisch auslaufend, beginnt genau mit der Fingergeschwindigkeit: Ausgleiten
+    Fling,
+}
+
+impl StripEasing {
+    fn apply(self, t: f64) -> f64 {
+        match self {
+            StripEasing::Gentle => (t * std::f64::consts::FRAC_PI_2).sin(),
+            StripEasing::Fling => 1.0 - (1.0 - t).powi(3),
+        }
+    }
+}
