+            Data::Group { sizes, .. } => {
+                let old = sizes[idx];
+                // auf das nächste Vielfache eines Zwölftels, so dass sich Breiten wie 1/3,
+                // 1/2 oder 2/3 genau treffen lassen
+                let new = if grow {
+                    (old / step + 1) * step
+                } else {
+                    ((old + step - 1) / step - 1) * step
+                }
+                .clamp(min, viewport_w.max(min));
+                sizes[idx] = new;
+                new != old
+            }
+            _ => false,
+        };
