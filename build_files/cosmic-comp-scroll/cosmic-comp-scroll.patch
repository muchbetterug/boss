+    /// Aktueller Versatz und seine Grenzen im neuesten Baum: (aktuell, kleinster, größter).
+    fn strip_scroll_state(&self) -> Option<(i32, i32, i32)> {
+        let viewport = self.strip_viewport();
+        let tree = &self.queue.trees.back().unwrap().0;
+        let root = tree.get(tree.root_node_id()?).ok()?;
+        let Data::Group {
+            orientation: Orientation::Vertical,
+            sizes,
+            last_geometry: geo,
+            ..
+        } = root.data()
+        else {
+            return None;
+        };
+        let current = viewport.loc.x - geo.loc.x;
+        let (min, max) = TilingLayout::strip_bounds(
+            sizes.first().copied().unwrap_or(0),
+            sizes.last().copied().unwrap_or(0),
+            geo.size.w,
+            viewport.size.w,
+        );
+        Some((current, min, max))
+    }
